@baseUrl = http://localhost:8081
@presetId = 11111111-1111-1111-1111-111111111111
@jobId = 22222222-2222-2222-2222-222222222222

### Create a search preset
POST {{baseUrl}}/api/presets
Content-Type: application/json

{
  "platform": "hh",
  "name": "PHP vacancies",
  "query": "PHP",
  "settings": {
    "defaultExclusions": {
      "vacancyIds": [],
      "titleCategories": []
    }
  }
}

### List search presets for all platforms
GET {{baseUrl}}/api/presets

### Get one search preset
GET {{baseUrl}}/api/presets/{{presetId}}

### Update a search preset
PUT {{baseUrl}}/api/presets/{{presetId}}
Content-Type: application/json

{
  "platform": "hh",
  "name": "PHP vacancies",
  "query": "PHP",
  "settings": {
    "defaultExclusions": {
      "vacancyIds": [],
      "titleCategories": ["SEO"]
    }
  }
}

### Enqueue an HH parsing job
POST {{baseUrl}}/api/hh/jobs
Content-Type: application/json

{
  "presetId": "{{presetId}}",
  "exclusions": {
    "vacancyIds": [123456789],
    "titleCategories": ["SEO", "QA"]
  }
}

### List recent HH parsing jobs
GET {{baseUrl}}/api/hh/jobs

### Get one HH parse job
GET {{baseUrl}}/api/hh/jobs/{{jobId}}

### Delete a search preset
DELETE {{baseUrl}}/api/presets/{{presetId}}

### Check the OpenAPI document
GET {{baseUrl}}/openapi/v1.json
